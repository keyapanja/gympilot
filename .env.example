# ─────────────────────────────────────────────────────────────
# GymPilot environment variables
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Bypasses RLS — used for admin tasks & invites. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used in emails + auth redirects). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email transport ──────────────────────────────────────────
# Pick ONE provider below, then set EMAIL_DRY_RUN=false to actually send.
# Priority: SMTP (if SMTP_HOST set) → Resend → dry-run (console log).

# The "From" address. For Gmail this MUST be your Gmail address.
EMAIL_FROM="GymPilot <your.name@gmail.com>"

# Option A — SMTP (no domain needed; works with Gmail, Brevo, Mailgun, …)
#   Gmail: enable 2-Step Verification, then create an App Password
#          (Google Account → Security → App passwords) and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.name@gmail.com
SMTP_PASS=your-16-char-app-password
#   Brevo alternative: SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
#          SMTP_USER=<your-brevo-login>  SMTP_PASS=<brevo-smtp-key>

# Option B — Resend (https://resend.com → API Keys). Leave SMTP_HOST empty to use this.
RESEND_API_KEY=

# Set to false to send real emails. true = log to console (safe local default).
EMAIL_DRY_RUN=true
